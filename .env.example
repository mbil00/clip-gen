# Vision model used by the "Describe" button. Any OpenAI-compatible endpoint works.
#
# Local MLX (Apple Silicon), started separately with:
#   mlx_vlm.server --model ~/models/Qwen3-VL-30B-A3B-Instruct-4bit --port 8080
CLIP_GEN_MODEL_URL=http://127.0.0.1:8080/v1

# Optional. When empty, clip-gen uses whichever model the endpoint already has loaded.
CLIP_GEN_MODEL=

# Optional, only needed by endpoints that require a key.
CLIP_GEN_API_KEY=

CLIP_GEN_MAX_TOKENS=600

# Ollama alternative (needs a vision model, e.g. `ollama pull qwen2.5vl`):
# CLIP_GEN_MODEL_URL=http://127.0.0.1:11434/v1
# CLIP_GEN_MODEL=qwen2.5vl
